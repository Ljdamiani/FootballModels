cat(paste("\n p =", p, " q =", q, " ", link))
model_list <- list()
if(q > 0) model_list$past_obs  <- 1:q
if(p > 0) model_list$past_mean <- 1:p
start_vals <- NULL
if(!is.null(previous_model)){
start_vals <- make_start_from_previous(
previous_model,
model_list,
x
)
}
if(is.null(start_vals)){
start_vals <- list(method="GLM")
}
if(p == 0 && q == 0){
fit <- try({
if(is.null(x)){
glm(
y ~ 1,
family = poisson(link = link)
)
} else{
glm(
y ~ x,
family = poisson(link = link)
)
}
}, silent = TRUE)
if(inherits(fit, "try-error")){
fit <- NULL
}
} else{
fit <- try(
tsglm(
y,
xreg = x,
distr = distr,
link = link,
model = model_list,
info = "none",
score = FALSE,
start.control = list(
method = if(is.null(start_vals)) "GLM" else "fixed"
),
final.control = list(
optim.method = "BFGS",
optim.control = list(
maxit = 40,
reltol = 1e-5
)
)
),
silent = TRUE
)
if(inherits(fit,"try-error")){
fit <- NULL
}
}
start_vals
tsglm(
y,
xreg = x,
distr = distr,
link = link,
model = model_list,
info = "none",
score = FALSE,
start.control = list(
