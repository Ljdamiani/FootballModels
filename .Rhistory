predict_parx <- function(model, newx){
scaling  <- attr(model, "scaling")
is_dummy <- attr(model, "is_dummy")
# -------------------------
# SCALE NEWX
# -------------------------
if(!is.null(newx)){
newx <- as.matrix(newx)
for(j in seq_len(ncol(newx))){
if(!is_dummy[j]){
minj <- scaling$min[j]
maxj <- scaling$max[j]
range <- maxj - minj
if(range == 0) range <- 1
newx[,j] <- (newx[,j] - minj) / range
}
}
}
# -------------------------
# GLM (1-step ahead)
# -------------------------
if(inherits(model, "glm")){
if(is.null(newx)){
return(as.numeric(predict(model, type = "response")[1]))
}
newdata <- as.data.frame(newx[nrow(newx), , drop = FALSE])
colnames(newdata) <- names(coef(model))[-1]
return(
as.numeric(
predict(
model,
newdata = newdata,
type = "response"
)
)
)
}
# -------------------------
# TSGLM (1-step ahead)
# -------------------------
predict(
model,
n.ahead = 1,
newxreg = newx
)$pred
}
lambda_A <- predict_parx(
models[[paste0(away,"_A")]],
row_A[,x_col,drop=FALSE]
)
lambda_A
