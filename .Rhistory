UNIFICADO_SB <- df_sb %>%
group_by(SB_id, SB_season_id, SB_team_id) %>%
mutate(
SB_all_leagues      = paste(competition_name, collapse = " | "),
SB_minutes_sum      = sum(minutes, na.rm = TRUE),
SB_appearances_sum  = sum(appearances, na.rm = TRUE)
) %>%
summarise(
across(
where(is.numeric) & !all_of("minutes"),
~ weighted.mean(.x, minutes, na.rm = TRUE)
),
across(where(~ !is.numeric(.x)), first),
.groups = "drop"
)
num_cols <- df_sb %>% select(where(is.numeric)) %>% names()
num_cols <- setdiff(num_cols, "minutes")
UNIFICADO_SB <- df_sb %>%
group_by(SB_id, SB_season_id, SB_team_id) %>%
summarise(
SB_all_leagues     = paste(competition_name, collapse = " | "),
SB_minutes_sum     = sum(minutes, na.rm = TRUE),
SB_appearances_sum = sum(appearances, na.rm = TRUE),
across(all_of(num_cols),
~ weighted.mean(.x, minutes, na.rm = TRUE)),
across(-c(all_of(num_cols), minutes), first),
.groups = "drop"
)
num_cols
